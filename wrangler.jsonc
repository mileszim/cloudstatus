/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudstatus",
	"compatibility_date": "2026-08-23",
	/**
	 * Custom worker entry. vinext's default (`vinext/server/fetch-handler`) only exports
	 * `fetch`; we delegate to it and add a `scheduled` handler for the monitoring cron.
	 */
	"main": "worker/index.ts",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	/** Everything the status page stores: components, incidents, monitors, subscribers. */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloudstatus",
			// Replace with the id from `npx wrangler d1 create cloudstatus`.
			// Local development uses miniflare's own store and ignores this value.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],

	/**
	 * Subscriber notification fan-out.
	 *
	 * The producer binding is used by every write that notifies subscribers; the
	 * consumer delivers them off the request path. Queues owns retry scheduling
	 * and the dead-letter hand-off, so there is no polling loop.
	 *
	 * Create both with:
	 *   npx wrangler queues create cloudstatus-notifications
	 *   npx wrangler queues create cloudstatus-notifications-dlq
	 */
	"queues": {
		"producers": [
			{
				"binding": "NOTIFICATIONS",
				"queue": "cloudstatus-notifications"
			}
		],
		"consumers": [
			{
				"queue": "cloudstatus-notifications",
				// Small batches: each message is an outbound email or HTTP call, and
				// a smaller batch means a poisoned message retries less company.
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "cloudstatus-notifications-dlq",
				// Cap concurrency so a large incident cannot open hundreds of
				// simultaneous connections to one mail provider.
				"max_concurrency": 3
			},
			{
				// Terminal failures. The handler records why on the notification row
				// so the delivery log in the dashboard shows what happened.
				"queue": "cloudstatus-notifications-dlq",
				"max_batch_size": 10,
				"max_retries": 0
			}
		]
	},

	/**
	 * Outbound subscriber email. Requires a domain onboarded to Cloudflare Email Service.
	 * Without it, email notifications are skipped and logged; every other channel still works.
	 */
	"send_email": [
		{
			"name": "EMAIL"
			// Add "remote": true to send real mail from `wrangler dev`. Left off so
			// local development simulates delivery (messages are written to disk).
		}
	],

	/**
	 * "* * * * *"  — run due monitor checks, transition scheduled maintenance, retry notifications.
	 * "17 3 * * *" — roll raw checks into daily uptime buckets and prune old rows.
	 */
	"triggers": {
		"crons": ["* * * * *", "17 3 * * *"]
	},

	"vars": {
		"SITE_URL": "http://localhost:3000"
	}
}
