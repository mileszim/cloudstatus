# Copy to .dev.vars and fill in. Never commit .dev.vars.
#
# Two ways to supply the four secrets below:
#
#   1. seekrit — set SEEKRIT_TOKEN only and leave the rest blank. Every lookup
#      goes through lib/secrets.ts, which resolves and decrypts them at runtime.
#   2. Directly — set them here (or with `wrangler secret put <NAME>`). A value
#      set this way always wins over seekrit, so it also works as break-glass.

# `skt_...` service token for the app environment this deployment reads.
SEEKRIT_TOKEN=

# Generate the password verifier with:
#   npm run hash-password -- "your-admin-password"
ADMIN_PASSWORD_HASH=

# Signs admin session cookies. Any long random string; rotating it signs everyone out.
#   openssl rand -hex 32
SESSION_SECRET=

# Verifies the HMAC on POST /api/hooks/generic.
INGEST_SECRET=

# Sender address, on a domain onboarded to Cloudflare Email Service.
EMAIL_FROM=status@example.com
