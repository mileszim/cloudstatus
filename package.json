{
  "name": "cloudstatus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@seekrit/sdk": "^0.7.0",
    "@vinext/cloudflare": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "latest",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.125.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "seed": "node scripts/seed.mjs > .seed.sql && wrangler d1 execute cloudstatus --local --file .seed.sql",
    "migrate:local": "wrangler d1 migrations apply cloudstatus --local",
    "migrate:remote": "wrangler d1 migrations apply cloudstatus --remote",
    "hash-password": "node scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit"
  }
}
